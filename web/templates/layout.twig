<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ app.request.basepath }}{{ asset_version('/assets/css/style.css') }}">
    <link rel="shortcut icon" href="{{ app.request.basepath }}/favicon.png">
    <link rel="search" href="{{ app.request.basepath }}/opensearch.xml" type="application/opensearchdescription+xml" title="WPackagist">
    <script src="{{ app.request.basepath }}{{ asset_version('/assets/js/segment.js') }}" async></script>
</head>
<body>
    <!-- WP Engine Meta Navigation -->
    {% include 'metanav.twig' %}

    {% block content %}{% endblock %}

